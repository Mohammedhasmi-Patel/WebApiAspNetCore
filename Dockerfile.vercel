# Build Stage
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /app
COPY ["src/api.csproj", "src/"]
RUN dotnet restore "src/api.csproj"
COPY . .
WORKDIR "/app/src"
RUN dotnet build "api.csproj" -c Release -o /app/build
RUN dotnet publish "api.csproj" -c Release -o /app/publish

# Final Stage
FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS final
WORKDIR /app
COPY --from=build /app/publish .

# Disable Server Garbage Collection. Vercel functions have strict memory limits.
# Server GC attempts to allocate too much memory upfront per core, causing a SIGSEGV (Code 139) crash.
ENV DOTNET_gcServer=0

# Disable diagnostic ports. Serverless environments like Vercel block the named pipes/sockets 
# that .NET tries to open for diagnostics, which can cause instant startup crashes.
ENV DOTNET_EnableDiagnostics=0

# Run in globalization invariant mode to prevent crashes related to missing ICU (language) libraries
# in minimal Linux container environments.
ENV DOTNET_SYSTEM_GLOBALIZATION_INVARIANT=1

# Disable inotify file watchers which can crash serverless containers when they try to monitor appsettings.json
ENV DOTNET_USE_POLLING_FILE_WATCHER=1
ENV DOTNET_HOSTBUILDER__RELOADCONFIGONCHANGE=false

# The PORT environment variable is automatically injected by Vercel
# Our Program.cs is configured to read this variable and listen on it.
ENTRYPOINT ["dotnet", "api.dll"]
